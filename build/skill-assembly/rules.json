{
  "version": 1,
  "phase": 1,
  "artifact_target": {
    "install_path": "skills",
    "source_path": "src/skills",
    "mode": "copy-through"
  },
  "scope": {
    "skills": [
      "duck-*"
    ]
  },
  "io": {
    "include": [
      "SKILL.md",
      "references/**"
    ],
    "source_template": "src/skills/{skill}/",
    "output_template": "skills/{skill}/"
  },
  "invariants": [
    {
      "id": "install-target",
      "description": "Assembled artifacts must be written to skills/<name>/ for npx skills consumption."
    },
    {
      "id": "parity",
      "description": "skills/<name>/** must match assembled output from src/skills/<name>/**."
    },
    {
      "id": "portability-no-repo-policy-refs",
      "description": "Skill text must not reference repo-coupled policy files.",
      "deny_tokens": [
        "AGENTS.md",
        "/mnt/",
        "/home/",
        "C:\\\\"
      ]
    },
    {
      "id": "guardrail-semantics",
      "description": "Skill must include or reference guardrail semantics.",
      "required_semantics": [
        "decision ownership",
        "ask-before-act",
        "evidence-first",
        "bounded approval",
        "safety carve-outs"
      ]
    }
  ],
  "checks": {
    "required_files": [
      "src/skills/shared/GUARDRAILS.md",
      "src/skills/duck-debt/SKILL.md",
      "src/skills/duck-debug/SKILL.md",
      "src/skills/duck-design/SKILL.md",
      "src/skills/duck-explain/SKILL.md",
      "src/skills/duck-review/SKILL.md",
      "src/skills/duck-teach/SKILL.md",
      "src/skills/duck-triage/SKILL.md",
      "skills/duck-debt/SKILL.md",
      "skills/duck-debt/references/GUARDRAILS.md",
      "skills/duck-debug/SKILL.md",
      "skills/duck-debug/references/GUARDRAILS.md",
      "skills/duck-design/SKILL.md",
      "skills/duck-design/references/GUARDRAILS.md",
      "skills/duck-explain/SKILL.md",
      "skills/duck-explain/references/GUARDRAILS.md",
      "skills/duck-review/SKILL.md",
      "skills/duck-review/references/GUARDRAILS.md",
      "skills/duck-teach/SKILL.md",
      "skills/duck-teach/references/GUARDRAILS.md",
      "skills/duck-triage/SKILL.md",
      "skills/duck-triage/references/GUARDRAILS.md"
    ],
    "text_assertions": [
      {
        "file": "src/skills/duck-debug/SKILL.md",
        "contains": "Keep language terse and practical."
      },
      {
        "file": "skills/duck-debug/SKILL.md",
        "contains": "Keep language terse and practical."
      }
    ]
  },
  "notes": [
    "Phase 1 defines contract only; assembler and CI drift checks come in later slices."
  ]
}
