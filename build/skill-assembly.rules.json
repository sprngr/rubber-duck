{
  "version": 1,
  "phase": 1,
  "invariants": [
    {
      "id": "portability-no-repo-policy-refs",
      "description": "Skill text must not reference repo-coupled policy files.",
      "deny_tokens": [
        "AGENTS.md",
        "/mnt/",
        "/home/",
        "C:\\\\"
      ]
    }
  ],
  "checks": {
    "required_files": [
      "src/shared/references/GUARDRAILS.md",
      "src/shared/policy-snippets/approval-change-types.md",
      "src/shared/policy-snippets/approval-workflow-core.md",
      "src/shared/policy-snippets/approval-scope-rules.md",
      "src/shared/policy-snippets/approval-intent-lexicon.md",
      "src/shared/policy-snippets/mutating-action-gate.md"
    ],
    "required_dir_file_sets": [
      {
        "dirs_glob": "src/skills/*",
        "required_files": [
          "SKILL.md"
        ]
      }
    ],
    "skill_groups": {
      "all_skills": [
        "duck-adapt",
        "duck-adventure",
        "quack",
        "duck-debt",
        "duck-debug",
        "duck-design",
        "duck-grill",
        "duck-patch",
        "duck-refactor",
        "duck-review",
        "duck-risk",
        "duck-simplify",
        "duck-teach",
        "duck-triage",
        "duck-tape"
      ],
      "skills_with_ladder": [
        "duck-debug",
        "duck-design",
        "duck-review"
      ],
      "skills_with_safety": [
        "quack",
        "duck-debt",
        "duck-design",
        "duck-teach",
        "duck-triage"
      ],
      "skills_with_mutating_gate": [
        "duck-debug",
        "duck-tape"
      ]
    },
    "group_assertions": {
      "all_skills": [
        "{{include: skill-snippets/philosophy-guardrails.md}}",
        "{{include: skill-snippets/clarify-first-preflight.md}}"
      ],
      "skills_with_ladder": [
        "{{include: skill-snippets/duck-ladder-core.md}}"
      ],
      "skills_with_safety": [
        "{{include: policy-snippets/safety-carveouts.md}}"
      ],
      "skills_with_mutating_gate": [
        "{{include: policy-snippets/mutating-action-gate.md}}"
      ]
    },
    "markdown_duplicate_heading_checks": [
      {
        "files_glob": "skills/*/SKILL.md",
        "min_level": 2
      }
    ],
    "markdown_asset_ref_checks": [
      {
        "files_glob": "skills/*/SKILL.md"
      }
    ]
  },
  "notes": [
    "Enforced by scripts/assemble-skills.sh in --check mode (including grouped assertions)."
  ]
}
