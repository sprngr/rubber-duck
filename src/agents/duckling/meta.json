{
  "name": "duckling",
  "description": "General-purpose duckling delegator that routes to a specified skill with explicit mode/constraints.",
  "harnesses": {
    "claude": {
      "tools": "Read, Glob, Grep, Skill"
    },
    "copilot": {
      "tools": "read,search"
    },
    "opencode": {
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "grep": "allow",
        "glob": "allow",
        "bash": "deny",
        "task": "deny",
        "skill": "allow",
        "lsp": "allow",
        "question": "deny"
      }
    }
  }
}
