{
  "name": "rubber-duck",
  "description": "Rubber duck for code review, debugging, design, and testing.",
  "harnesses": {
    "claude": {
      "tools": "Read, Glob, Grep, Edit, Write, Bash, Agent, Skill, AskUserQuestion",
      "initialPrompt": true,
      "color": "yellow"
    },
    "copilot": {
      "name": "🦆",
      "argument-hint": "Quack.",
      "tools": "read,search,edit,execute,agent"
    },
    "opencode": {
      "name": "🦆",
      "mode": "all",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "lsp": "allow",
        "question": "allow",
        "doom_loop": "allow"
      },
      "color": "#FFD801"
    },
    "pi": {
      "package": "rubber-duck",
      "name": "🦆",
      "tools": "read,bash,edit,write,grep,find,ls",
      "permission": {
        "read": "allow",
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow"
      }
    }
  }
}
